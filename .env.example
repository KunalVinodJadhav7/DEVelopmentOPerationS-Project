# Application
APP_PORT=8000
DATABASE_URL=sqlite:///./leave_approval.db
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes

# PostgreSQL
POSTGRES_DB=leave_approval_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional Jenkins remote trigger used by scripts/start_with_jenkins.sh/.ps1
JENKINS_URL=http://localhost:8080
JENKINS_JOB=Employee-Leave-Approval
JENKINS_USER=your-jenkins-user
JENKINS_API_TOKEN=replace-with-your-jenkins-api-token